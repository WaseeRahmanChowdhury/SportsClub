<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="530.0" prefWidth="490.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group2.sportclub.wasee_rahman_chowdhury.MarkMyAttendanceController">
   <children>

      <Label layoutX="20.0" layoutY="15.0" text="Mark My Attendance">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Label>

      <!-- session details entered by the player -->
      <Label layoutX="20.0" layoutY="65.0" text="Session Name:" />
      <ComboBox fx:id="sessionNameCombo" layoutX="160.0" layoutY="60.0" prefWidth="300.0" />

      <Label layoutX="20.0" layoutY="100.0" text="Session Date:" />
      <DatePicker fx:id="datePicker" layoutX="160.0" layoutY="95.0" prefWidth="300.0" />

      <Label fx:id="statusLabel" layoutX="20.0" layoutY="140.0" prefWidth="450.0" wrapText="true" />

      <!-- event-4: player clicks 'Mark My Attendance' button -->
      <Button layoutX="20.0" layoutY="480.0" onAction="#markAttendance" prefHeight="32.0" prefWidth="200.0" text="Mark My Attendance" />

   </children>
</AnchorPane>
