<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="530.0" prefWidth="490.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group2.sportclub.wasee_rahman_chowdhury.RequestLeaveController">
   <children>

      <Label layoutX="20.0" layoutY="15.0" text="Request Leave">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Label>

      <Label layoutX="20.0" layoutY="65.0" text="Leave Type:" />
      <ComboBox fx:id="leaveTypeCombo" layoutX="150.0" layoutY="60.0" prefWidth="200.0" />

      <Label layoutX="20.0" layoutY="105.0" text="Start Date:" />
      <DatePicker fx:id="startDatePicker" layoutX="150.0" layoutY="100.0" prefWidth="200.0" />

      <Label layoutX="20.0" layoutY="145.0" text="End Date:" />
      <DatePicker fx:id="endDatePicker" layoutX="150.0" layoutY="140.0" prefWidth="200.0" />

      <Label fx:id="statusLabel" layoutX="20.0" layoutY="190.0" prefWidth="450.0" wrapText="true" />

      <Button layoutX="370.0" layoutY="500.0" onAction="#submitLeaveRequest" prefHeight="27.0" prefWidth="100.0" text="Submit" />

   </children>
</AnchorPane>
