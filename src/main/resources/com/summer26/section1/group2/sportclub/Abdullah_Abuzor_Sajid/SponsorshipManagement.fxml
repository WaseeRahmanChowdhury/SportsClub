<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="820.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group2.sportclub.Abdullah_Abuzor_Sajid.SponsorshipManagementController">
    <children>

        <Label layoutX="20.0" layoutY="15.0" text="Sponsorship Management">
            <font>
                <Font name="Arial Bold" size="16.0" />
            </font>
        </Label>

        <Button fx:id="addSponsorButton" layoutX="533.0" layoutY="13.0" onAction="#openAddSponsor" prefWidth="120.0" text="Add New Sponsor" />
        <Button fx:id="deleteSponsorButton" layoutX="664.0" layoutY="13.0" onAction="#deleteSelectedSponsor" prefWidth="110.0" text="Delete Selected" />
        <TableView fx:id="sponsorTable" prefHeight="312.0" prefWidth="760.0" AnchorPane.bottomAnchor="448.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="60.0">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="170.0" text="Sponsor Name" />
                <TableColumn fx:id="amountColumn" prefWidth="140.0" text="Annual Amount (BDT)" />
                <TableColumn fx:id="startDateColumn" prefWidth="110.0" text="Contract Start" />
                <TableColumn fx:id="endDateColumn" prefWidth="110.0" text="Contract End" />
            </columns>
        </TableView>

        <!-- Edit panel: select a row above to populate these fields, same pattern as Staff Directory. -->
        <AnchorPane prefHeight="215.0" prefWidth="800.0" AnchorPane.bottomAnchor="230.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <Label layoutX="20.0" layoutY="0.0" text="Edit Selected Sponsor">
                    <font>
                        <Font name="Arial Bold" size="13.0" />
                    </font>
                </Label>

                <Label layoutX="20.0" layoutY="30.0" text="Sponsor ID:" />
                <Label fx:id="selectedSponsorIdLabel" layoutX="150.0" layoutY="30.0" prefWidth="220.0" />

                <Label layoutX="20.0" layoutY="65.0" text="Company Name:" />
                <TextField fx:id="editCompanyNameField" layoutX="150.0" layoutY="60.0" prefWidth="220.0" />

                <Label layoutX="20.0" layoutY="100.0" text="Contact Person:" />
                <TextField fx:id="editContactPersonField" layoutX="150.0" layoutY="95.0" prefWidth="220.0" />

                <Label layoutX="20.0" layoutY="135.0" text="Contact Number:" />
                <TextField fx:id="editContactNumberField" layoutX="150.0" layoutY="130.0" prefWidth="220.0" />

                <Label layoutX="420.0" layoutY="30.0" text="Amount / Year:" />
                <TextField fx:id="editAnnualAmountField" layoutX="540.0" layoutY="25.0" prefWidth="220.0" />

                <Label layoutX="420.0" layoutY="65.0" text="Contract Start:" />
                <DatePicker fx:id="editContractStartField" layoutX="540.0" layoutY="60.0" prefWidth="220.0" />

                <Label layoutX="420.0" layoutY="100.0" text="Contract End:" />
                <DatePicker fx:id="editContractEndField" layoutX="540.0" layoutY="95.0" prefWidth="220.0" />

                <Button layoutX="630.0" layoutY="130.0" onAction="#saveChanges" prefHeight="30.0" prefWidth="130.0" text="Save Changes" />

                <Label fx:id="statusLabel" layoutX="20.0" layoutY="195.0" prefWidth="760.0" textFill="RED" wrapText="true" />
            </children>
        </AnchorPane>

        <AnchorPane prefHeight="230.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <Label layoutX="20.0" layoutY="10.0" text="Sponsorship Share by Company">
                    <font>
                        <Font name="Arial Bold" size="13.0" />
                    </font>
                </Label>

                <PieChart fx:id="sponsorshipChart" legendVisible="true" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="35.0" />
            </children>
        </AnchorPane>

    </children>
</AnchorPane>
