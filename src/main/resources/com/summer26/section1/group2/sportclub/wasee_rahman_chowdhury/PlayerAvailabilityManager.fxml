<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group2.sportclub.wasee_rahman_chowdhury.PlayerAvailabilityManagerController"
            prefHeight="620.0" prefWidth="560.0">

    <Label layoutX="20.0" layoutY="15.0" text="Player Availability Manager" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label layoutX="20.0" layoutY="65.0" text="Player Name:"/>
    <TextField fx:id="nameField" layoutX="140.0" layoutY="61.0" prefWidth="180.0"/>

    <Label layoutX="340.0" layoutY="65.0" text="Position:"/>
    <TextField fx:id="positionField" layoutX="410.0" layoutY="61.0" prefWidth="120.0"/>

    <Label layoutX="20.0" layoutY="100.0" text="Status:"/>
    <ComboBox fx:id="statusCombo" layoutX="140.0" layoutY="96.0" prefWidth="180.0"/>

    <Button layoutX="410.0" layoutY="96.0" prefWidth="120.0" text="Add Player" onAction="#onAddPlayer"/>

    <TableView fx:id="playerTable" layoutX="20.0" layoutY="140.0" prefWidth="510.0" prefHeight="330.0">
        <columns>
            <TableColumn fx:id="colName" text="Player Name" prefWidth="150.0"/>
            <TableColumn fx:id="colPosition" text="Position" prefWidth="110.0"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120.0"/>
            <TableColumn fx:id="colLastUpdated" text="Last Updated" prefWidth="128.0"/>
        </columns>
    </TableView>

    <Label layoutX="20.0" layoutY="485.0" text="Select a player above, then choose a new status:"/>

    <Label layoutX="20.0" layoutY="515.0" text="New Status:"/>
    <ComboBox fx:id="updateStatusCombo" layoutX="140.0" layoutY="511.0" prefWidth="180.0"/>

    <Button layoutX="340.0" layoutY="511.0" prefWidth="150.0" text="Update Status" onAction="#onUpdateStatus"/>

    <Label fx:id="statusLabel" layoutX="20.0" layoutY="555.0" wrapText="true" prefWidth="510.0"/>

</AnchorPane>
