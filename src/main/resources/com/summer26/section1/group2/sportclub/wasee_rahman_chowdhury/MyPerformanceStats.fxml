<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="490.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group2.sportclub.wasee_rahman_chowdhury.MyPerformanceStatsController">
   <children>

      <Label layoutX="20.0" layoutY="15.0" text="My Performance Stats">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Label>

      <Label layoutX="20.0" layoutY="60.0" text="Appearances:" />
      <TextField fx:id="appearancesField" layoutX="150.0" layoutY="56.0" prefWidth="100.0" />

      <Label layoutX="270.0" layoutY="60.0" text="Goals:" />
      <TextField fx:id="goalsField" layoutX="330.0" layoutY="56.0" prefWidth="100.0" />

      <Label layoutX="20.0" layoutY="95.0" text="Minutes Played:" />
      <TextField fx:id="minutesField" layoutX="150.0" layoutY="91.0" prefWidth="100.0" />

      <Button layoutX="300.0" layoutY="90.0" onAction="#saveStat" prefHeight="27.0" prefWidth="160.0" text="Save Stat" />

      <TableView fx:id="statsTable" layoutX="20.0" layoutY="140.0" prefHeight="440.0" prefWidth="450.0">
         <columns>
            <TableColumn fx:id="colAppearances" prefWidth="142.6666259765625" text="Appearances" />
            <TableColumn fx:id="colGoals" prefWidth="104.666748046875" text="Goals" />
            <TableColumn fx:id="colMinutes" prefWidth="202.6666259765625" text="Minutes Played" />
         </columns>
      </TableView>

   </children>
</AnchorPane>
